[Unit]
Description=Entry Ticket System API
After=network.target

[Service]
Type=simple
User=yama_can
WorkingDirectory=/home/yama_can/entry.w-pcp.dev
EnvironmentFile=/etc/entry-w-pcp/backend.env
ExecStart=/usr/bin/node --experimental-strip-types backend/src/index.ts
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
